{
  "name": "focus-study-sprint",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src && playwright test",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "test:live-contract": "node scripts/verify-live-contract.mjs",
    "test:release": "npm test && npm run lint && npm run build && npm run test:live-contract"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "lighthouse": "^13.4.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
